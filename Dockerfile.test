FROM node:20-alpine

# Install network tools
RUN apk add --no-cache \
    iproute2 \
    iptables \
    dnsmasq \
    net-tools \
    bash \
    sudo

# Create app user
RUN adduser -D -s /bin/bash routerapp && \
    echo "routerapp ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

WORKDIR /app

# Copy backend
COPY backend/package*.json ./backend/
RUN cd backend && npm install

COPY backend ./backend

# Expose API port
EXPOSE 3000

USER routerapp

CMD ["node", "backend/src/server.js"]
